{
  "manifest_version": 3,
  "name": "RAQEEB Link Guard",
  "short_name": "RAQEEB",
  "version": "0.3.1",
  "description": "Checks links you click in WhatsApp Web, Gmail, Outlook and Telegram with RAQEEB before they open, and marks fake bank and government sites in Google and Bing results. Student hackathon project, not a government service.",
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RAQEEB Link Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.ae/search*",
        "https://www.bing.com/search*"
      ],
      "js": [
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "check.html",
        "check.js",
        "style.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ]
    }
  ]
}
