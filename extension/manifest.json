{
  "manifest_version": 3,
  "name": "RAQEEB Link Guard",
  "short_name": "RAQEEB",
  "version": "0.1.0",
  "description": "Checks links you click in WhatsApp Web, Gmail, Outlook and Telegram with RAQEEB before they open. Student hackathon project, not a government service.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "RAQEEB Link Guard", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
