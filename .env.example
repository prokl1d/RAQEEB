# Copy to backend/.env and fill in your own keys. Never commit backend/.env.
# All keys are optional: a missing key means that check shows as "unavailable".

# AI: "mock" (no key, offline) or "gemini"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Threat intelligence
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLSCAN_ENABLED=false

# Replay labelled demo fixtures instead of calling external APIs (for the live demo / no Wi-Fi)
OFFLINE_DEMO=false

# Turn all outbound checks off (DNS, TLS, redirects, RDAP, threat intel)
NETWORK_CHECKS=true
